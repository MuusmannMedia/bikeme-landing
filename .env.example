NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only opt-in; exact environment/backend pairing and owner/admin RPC rights apply.
BIKE_ME_CLUB_PROFILE_EDIT_ENABLED=false

# Server-only visitor opt-in; exact production backend and DB flags also required.
BIKE_ME_CLUB_VISITS_ENABLED=false

# Private catalogue delivery; signing key belongs only in server secret configuration.
BIKE_ME_VISIT_CATALOG_ENABLED=false
BIKE_ME_VISIT_CATALOG_SIGNING_KEY=
BIKE_ME_CLUB_RIDE_PUSH_ENABLED=false
